  "driver_source": "function run(argv) {\n  ObjC.import('Foundation');\n  function read(name) {\n    return JSON.parse(ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(\n      $(name), $.NSUTF8StringEncoding, null)));\n  }\n  const receipt = read('tests/scenarios/2026-10-13-checkpoint-review-followup-candidate.json');\n  const schema = receipt.validator_schema;\n  const validate = new Function('schema', 'return (' + receipt.validator_source + ')')(schema);\n  const examples = ['complete', 'partial', 'stale'].map(n =>\n    read('skills/managing-superpowers-backlog/references/checkpoint-' + n + '-example.json'));\n  const edges = read('tests/scenarios/2026-10-13-checkpoint-native-edge-candidate.json').candidate_projections;\n  const added = read('tests/scenarios/2026-10-13-checkpoint-review-followup-fixtures.json').cases;\n  function clone(v) { return JSON.parse(JSON.stringify(v)); }\n  function normalize(d) {\n    for (const p of d.pull_requests) {\n      if (!d.scope.collections.some(c => c.name === 'closingIssuesReferences' && c.owner_id === p.id)) {\n        d.scope.collections.push({name:'closingIssuesReferences', owner_id:p.id,\n          expected_total:0, pages:[{cursor_in:null, cursor_out:null,\n            record_ids:[], has_next_page:false}], complete:true});\n      }\n    }\n    return d;\n  }\n  const results = receipt.tests.map(t => {\n    const parts = t.input.split(':');\n    const index = Number(parts[1]);\n    let d = parts[0] === 'current-example' ? clone(examples[index]) :\n      parts[0] === 'historical-native-edge' ? normalize(clone(edges[index])) :\n      clone(added[index].record);\n    if (t.mutation) eval('(' + t.mutation + ')')(d);\n    if (t.name === 'contradictory Project projection') {\n      for (const item of d.project.items) for (const value of item.fields) value.option_id = null;\n    }\n    const result = validate(d);\n    const observed = result.acceptable ? 'ACCEPTABLE' : result.valid ? 'DIAGNOSTIC' : 'REJECT';\n    return {name:t.name, input:t.input, mutation:t.mutation, expected:t.expected,\n      observed:observed, result:observed === t.expected ? 'PASS' : 'FAIL', errors:result.errors};\n  });\n  return JSON.stringify({version:'issue-31-integrated-native-replay/v1',\n    validator_receipt:'tests/scenarios/2026-10-13-checkpoint-review-followup-candidate.json',\n    normalization:receipt.normalization, scope:receipt.scope,\n    tests:results, pass:results.filter(t => t.result === 'PASS').length,\n    fail:results.filter(t => t.result === 'FAIL').length}, null, 2);\n}\n",
