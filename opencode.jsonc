{
  "$schema": "https://opencode.ai/config.json",
  // Repository-scoped Superpowers install. Pinned to the current stable
  // release. Both plugins are enabled only for this repository.
  // SUPERPOWERS.md remains the upstream dependency record.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.1",
    "git+https://github.com/tvproductions/gz-skills.git#v0.8.3"
  ],
  // Backplane's own development skills supplement the managed plugins.
  "skills": ["./skills"]
}
